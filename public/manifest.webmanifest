{
  "name": "xBrowserSync Bookmarks",
  "short_name": "Bookmarks",
  "description": "An unofficial, read-only mobile client for xBrowserSync. Decrypts your bookmarks on-device.",
  "id": "./app.html",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f8f9",
  "theme_color": "#1b6b7d",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
